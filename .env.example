# Copy this file to .env and fill in your Z.ai API key.
# The OpenAI-compatible general endpoint is used because RD-Agent needs both
# chat completions and text embeddings.
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
CHAT_MODEL=openai/glm-4.7
EMBEDDING_MODEL=openai/embedding-3
OPENAI_API_BASE=https://api.z.ai/api/paas/v4
OPENAI_API_KEY=

# Used by scripts/check_etf_environment.py.  The stock-oriented RD-Agent Qlib
# templates need a separate ETF adapter before this path can be used by
# `rdagent fin_factor` or `rdagent fin_quant`.
ETF_QLIB_PROVIDER_URI=D:\qlib_data\etf_qlib_data
